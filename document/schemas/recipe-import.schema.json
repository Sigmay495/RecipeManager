{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://recipe-manager.local/schemas/recipe-import-1.0.json",
  "title": "Recipe Manager Recipe Import",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "fileType", "recipes"],
  "properties": {
    "schemaVersion": {
      "const": "1.0"
    },
    "fileType": {
      "const": "recipe-import"
    },
    "generatedAt": {
      "type": ["string", "null"],
      "format": "date-time"
    },
    "recipes": {
      "type": "array",
      "minItems": 1,
      "maxItems": 100,
      "items": {
        "$ref": "#/$defs/recipe"
      }
    }
  },
  "$defs": {
    "recipe": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "category", "ingredients"],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 100
        },
        "category": {
          "enum": ["one_dish", "main", "side", "soup"]
        },
        "ingredients": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/ingredient"
          }
        },
        "cookingTimeMinutes": {
          "type": ["integer", "null"],
          "minimum": 1,
          "maximum": 1440
        },
        "effortLevel": {
          "enum": ["easy", "normal", "hard"],
          "default": "normal"
        },
        "sourceUrl": {
          "type": ["string", "null"],
          "format": "uri",
          "pattern": "^[Hh][Tt][Tt][Pp][Ss]?://",
          "maxLength": 2048
        },
        "memo": {
          "type": "string",
          "maxLength": 2000,
          "default": ""
        },
        "warnings": {
          "type": "array",
          "items": {
            "type": "string",
            "maxLength": 500
          },
          "default": []
        }
      }
    },
    "ingredient": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "amount", "unit"],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 100
        },
        "amount": {
          "type": ["number", "null"],
          "exclusiveMinimum": 0
        },
        "unit": {
          "type": "string",
          "maxLength": 20
        },
        "note": {
          "type": "string",
          "maxLength": 200,
          "default": ""
        }
      }
    }
  }
}
